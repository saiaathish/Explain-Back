LLM_API_KEY=
# Application requests use prod. CI harnesses override this process-local role.
LLM_ROLE=prod
LLM_MODEL_PROD=
LLM_MODEL_CI=gemma-4-31b-it
# Legacy production fallback during migration.
LLM_MODEL=
# Optional. Image and audio calls fall back to the prod model when unset.
LLM_MODEL_VISION=
LLM_MODEL_AUDIO=
LLM_BASE_URL=https://api.openai.com/v1
FRONTEND_ORIGIN=http://localhost:5173
# Public project base URL only. The backend verifies access tokens via its
# asymmetric JWKS endpoint; never configure a service-role or secret key here.
SUPABASE_URL=
# Frontend-only public values are passed to Vite when running from `frontend/`:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
T_HIGH=
T_LOW=
