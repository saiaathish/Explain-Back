# Optional. Image and audio calls fall back to the prod model when unset.
LLM_MODEL_VISION=
LLM_MODEL_AUDIO=
LLM_BASE_URL=https://api.openai.com/v1
FRONTEND_ORIGIN=http://localhost:5173
T_HIGH=
T_LOW=
